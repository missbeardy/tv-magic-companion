# Copy to .env.local for local development (never commit .env.local)

# --- Client (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_ENABLE_PLATFORM_FEATURES=true
# vercel dev default; use http://localhost:5173 for vite-only (npm run dev)
VITE_PLATFORM_URL=http://localhost:3001

# --- Server (required for npm run dev:full / API routes) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ENABLE_PLATFORM_FEATURES=true

# Contact follow-up cron — local manual test:
# curl -H "Authorization: Bearer local-dev-cron-secret" http://localhost:3001/api/cron/contact-follow-up
CRON_SECRET=local-dev-cron-secret-change-me

# Platform workflow run logging — set true to disable workflow_runs writes
# WORKFLOW_RUN_LOGGING_DISABLED=true

# --- Optional: maps, SMS, push (match your Vercel preview/dev env) ---
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SMS alert when inbound cannot be routed to any org (unrouted_inbound capture)
PLATFORM_ALERT_PHONE=+61451177893
# Employee WhatsApp is disconnected pending an overhaul (free-form sends without an
# approved template fail Meta's 24h session window). Set true to re-enable once fixed.
EMPLOYEE_WHATSAPP_ENABLED=
# Employee alerts via WhatsApp — number only (e.g. +15559367913). Do not typo "whatsapp".
TWILIO_WHATSAPP_FROM=
# Approved Content Template SIDs (HX...) — variables {{1}}, {{2}}, … must match employeeWhatsAppTemplates.ts
# Or use a static assignment template (no {{variables}}) and set TWILIO_WHATSAPP_ASSIGNMENT_STATIC=true
TWILIO_WHATSAPP_ASSIGNMENT_STATIC=
# Number of {{n}} placeholders in assignment template (default 4). Use 3 to omit URL variable.
TWILIO_WHATSAPP_ASSIGNMENT_VAR_COUNT=
TWILIO_WHATSAPP_CONTENT_SID_ASSIGNMENT=
# Manager alert: {{1}} lead name, {{2}} URL — template body includes brand name (e.g. FieldBourne Digital)
TWILIO_WHATSAPP_CONTENT_SID_MANAGER_ALERT=
TWILIO_WHATSAPP_CONTENT_SID_FOLLOW_UP=
TWILIO_WHATSAPP_CONTENT_SID_NOTIFY=
TWILIO_WHATSAPP_CONTENT_SID_BOOKING=
# OneSignal — legacy push relay. Still the delivery path for any brand with the
# native_web_push switch off. Removed entirely in T1.13.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# --- Web Push / VAPID (T1.12) ---
# Generate ONCE per environment: npx web-push generate-vapid-keys
# Rotating the public key invalidates every existing subscription — do not regenerate.
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
# Server only. Never prefix with VITE_ — leaking it lets anyone push to your users.
VAPID_PRIVATE_KEY=
# Required by the spec; push services reject requests without it.
VAPID_SUBJECT=mailto:support@fieldbourne.com.au
# Shared secret for /api/send-sms?action=push-send. Must also be set as a Supabase
# Edge Function secret so notify-message can call the sender. Fail-closed if unset.
PUSH_SHARED_SECRET=local-dev-push-secret-change-me

# --- Observability (dd1) ---
# Sentry — free Developer plan. Errors only (tracesSampleRate: 0), both init calls no-op if unset.
SENTRY_DSN=
VITE_SENTRY_DSN=
# PostHog — free tier. Project API key (starts phc_), safe to expose client-side (write-only).
POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_PROJECT_TOKEN=
# Must match your PostHog project's region (Project Settings -> API host).
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Personal/secret key (starts phs_) — not used by capture calls, reserved for future query-API use (e.g. dd11).
POSTHOG_SECRET_KEY=

# --- Optional: AI / integrations ---
# Server-side only (api/anthropic.ts, api/_lib/extractLead.ts) — the model is chosen server-side
# per action (dd5: closed the client-supplied `messages`/model passthrough).
# ANTHROPIC_API_KEY=
# Per-org monthly Anthropic token ceiling for the /api/anthropic proxy — default 200000.
# AI_MONTHLY_TOKEN_CEILING=200000
# --- Inbound webhooks (required for simulator + CloudMailin/Twilio) ---
INBOUND_SECRET=local-dev-inbound-secret-change-me
VITE_CLOUDMAILIN_INBOUND_BASE=your-inbound@cloudmailin.net
# TWILIO_AUTH_TOKEN=  # required for SMS simulator only
# THREECX_WEBHOOK_SECRET=  # removed — 3CX missed-call webhook not used (voicemail via CloudMailin)
# STITCH_API_KEY=

# Stripe (test mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # SaaS billing webhook (checkout/portal for org subscriptions)
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...  # separate Connect webhook (invoice card payments) — configure a second endpoint in the Stripe Dashboard listening for connected-account events, pointed at /api/stripe-connect-webhook
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# Meta Messenger + Instagram DM webhook (same /api/meta-webhook endpoint)
# Used only for direct Meta webhooks — Facebook leads via Botpress use /api/inbound-facebook-lead instead.
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
